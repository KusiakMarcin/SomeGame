#version 330 core
layout (location = 0) in vec3 aPos; // the position variable has attribute position 0
  


vec3 rotate(vec3 pos,float time);
uniform float CurrentTime;
void main()
{
    
    gl_Position = vec4(rotate(aPos,CurrentTime), 1.0); // see how we directly give a vec3 to vec4's constructor
    

}

vec3 rotate(vec3 pos,float time)
{
    vec3 tmp;
    vec2 rotationMatrixX = vec2(cos(time),-sin(time));
    vec2 rotationMatrixY = vec2(sin(time),cos(time));
    vec2 x = vec2(pos.x,pos.y);
    x = x * rotationMatrixX;
    float X = x.x + x.y;
    vec2 y = vec2(pos.x,pos.y);
    y = y * rotationMatrixY;
    float Y = y.x + y.y;

    tmp = vec3(X,Y,0.0);


    return tmp;
}