#version 330 core

layout (location = 0) in vec2 aPos;
layout (location = 1) in vec2 aTexCoords;


out vec2 TexCoords;
out vec3 ShiftColor;

// Uniformy 
uniform mat4 model;      
uniform mat4 projection; 
uniform vec2 textOffset;
uniform float textWidth;
uniform vec3 ourColor;

void main()
{
    
    TexCoords = aTexCoords * vec2(textWidth,1.0f) +textOffset;
    ShiftColor = ourColor;
    
    
    gl_Position = projection * model * vec4(aPos,0.0, 1.0);
}