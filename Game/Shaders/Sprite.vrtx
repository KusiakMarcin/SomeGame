#version 330 core

layout (location = 0) in vec2 aPos;
layout (location = 1) in vec2 aTexCoords;


out vec2 TexCoords;
out vec3 ShiftColor;

uniform mat4 model;      
uniform mat4 projection; 
uniform vec3 ourColor;

void main()
{
    ShiftColor = ourColor;
    TexCoords = aTexCoords;

    
    gl_Position = projection * model * vec4(aPos,0.0, 1.0);
}