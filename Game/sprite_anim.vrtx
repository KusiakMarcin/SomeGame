#version 330 core
layout (location = 0) in vec3 aPos;
layout (location = 1) in vec2 aTexCoords; // Wejœciowe UV zazwyczaj to pe³en kwadrat (0,0) do (1,1)

out vec2 TexCoords;

uniform mat4 model;
uniform mat4 projection;

// NOWE UNIFORMY DO ANIMACJI
// Okreœla przesuniêcie lewego górnego rogu aktualnej klatki (np. vec2(0.25, 0.0))
uniform vec2 texOffset; 
// Okreœla rozmiar klatki w przestrzeni UV (np. vec2(0.25, 1.0) dla arkusza 4x1)
uniform vec2 texScale; 

void main()
{
    // Modyfikacja wspó³rzêdnych tekstury:
    // 1. Skalujemy wejœciowe UV do rozmiaru pojedynczej klatki (aTexCoords * texScale)
    // 2. Przesuwamy je w odpowiednie miejsce na arkuszu (+ texOffset)
    TexCoords = aTexCoords * texScale + texOffset;

    gl_Position = projection * model * vec4(aPos, 1.0);
}