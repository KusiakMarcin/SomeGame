#version 330 core

layout (location = 0) in vec2 aPos;
layout (location = 1) in vec2 aTexCoords;

// Wyjœcie do fragment shadera
out vec2 TexCoords;

// Uniformy - zmienne globalne ustawiane z poziomu kodu C++
uniform mat4 model;      // Macierz transformacji obiektu (pozycja, rotacja, skala)
uniform mat4 projection; // Macierz projekcji (zazwyczaj ortogonalna dla 2D)

void main()
{
    // Przekazujemy wspó³rzêdne tekstury do fragment shadera
    TexCoords = aTexCoords;

    // Obliczamy finaln¹ pozycjê na ekranie
    // Kolejnoœæ mno¿enia jest kluczowa: Projekcja * Model * Wierzcho³ek
    gl_Position = projection * model * vec4(aPos,0.0, 1.0);
}